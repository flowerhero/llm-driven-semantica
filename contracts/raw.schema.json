{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "raw.schema.json",
  "title": "Step 1 Ingest 输出 · RawDocument[]",
  "description": "Ingest 只做三件事：拿字节、算 checksum、记出处。不做任何解读。bytes 以 base64 编码，datetime 为 ISO8601 UTC。",
  "type": "array",
  "items": { "$ref": "#/definitions/RawDocument" },
  "definitions": {
    "SourceRef": {
      "type": "object",
      "required": ["source_id", "uri", "source_type"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "description": "来源稳定标识，同内容同 id" },
        "uri": { "type": "string", "description": "file:// / https:// / memory://inline/<sha256>" },
        "source_type": { "enum": ["file", "web", "db", "stream", "text"] },
        "checksum": { "type": ["string", "null"], "description": "sha256 十六进制" },
        "fetched_at": { "type": ["string", "null"], "format": "date-time" },
        "locator": { "type": ["string", "null"], "description": "页号/行号/锚点等次级定位" },
        "extra": { "type": "object" }
      }
    },
    "RawDocument": {
      "type": "object",
      "required": ["doc_id", "source", "checksum"],
      "additionalProperties": false,
      "properties": {
        "doc_id": { "type": "string" },
        "source": { "$ref": "#/definitions/SourceRef" },
        "media_type": { "type": "string", "default": "application/octet-stream" },
        "content": { "type": "string", "contentEncoding": "base64", "description": "原始字节的 base64。铁律：Ingest 不解码，编码猜测留给 Parse" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "fetched_at": { "type": ["string", "null"], "format": "date-time" },
        "metadata": { "type": "object" },
        "degradations": { "type": "array", "description": "降级登记：任何 fallback 都要出声，绝不静默", "items": { "$ref": "#/definitions/Degradation" } },
        "stats": { "type": "object" }
      }
    },
    "Degradation": {
      "type": "object",
      "required": ["component", "kind", "reason", "fallback", "impact"],
      "additionalProperties": false,
      "properties": {
        "component": { "type": "string" },
        "kind": { "enum": ["model_missing", "unavailable", "no_credential", "rate_limited", "parse_failed", "unsupported_format", "truncated"] },
        "reason": { "type": "string" },
        "fallback": { "type": "string" },
        "impact": { "type": "string" },
        "recoverable": { "type": "boolean", "default": true }
      }
    }
  }
}
