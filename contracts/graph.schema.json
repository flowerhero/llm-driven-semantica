{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "graph.schema.json",
  "title": "Step 5 BuildKG / Step 6 QA 输出 · KnowledgeGraph + QAResult",
  "description": "建图与质检几乎全在 Python（幂等语义必须是确定性位运算级别的一致）。Skill 只承担两件事：实体消歧建议、同义谓词归并 + 语义冲突识别。",
  "type": "object",
  "required": ["graph"],
  "additionalProperties": false,
  "properties": {
    "graph": { "$ref": "#/definitions/KnowledgeGraph" },
    "conflicts": { "type": "array", "items": { "$ref": "#/definitions/Conflict" } },
    "duplicate_clusters": { "type": "array", "items": { "$ref": "#/definitions/DuplicateCluster" } },
    "metrics": { "$ref": "#/definitions/QualityMetrics" },
    "disambiguation": {
      "type": "object",
      "description": "★ Skill（LLM）承担：实体消歧建议。Python 按此表归并 mention 到 canonical",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_type", "canonical", "surfaces"],
            "additionalProperties": false,
            "properties": {
              "entity_type": { "enum": ["PERSON", "ORGANIZATION", "LOCATION", "DATE", "TIME", "MONEY", "PERCENT", "QUANTITY", "PRODUCT", "EVENT", "CONCEPT", "OTHER"] },
              "canonical": { "type": "string", "description": "规范名：最完整、最正式的那个 surface" },
              "surfaces": { "type": "array", "items": { "type": "string" }, "description": "归入该实体的所有原文表面形式" },
              "rationale": { "type": "string", "description": "★ 必须给出理由；无法解释的归并不可接受" }
            }
          }
        }
      }
    },
    "predicate_normalization": {
      "type": "object",
      "description": "★ Skill（LLM）承担：同义谓词归并表，使改写表达但同义的关系也纳入冲突检测",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical", "variants"],
            "additionalProperties": false,
            "properties": {
              "canonical": { "type": "string", "description": "规范谓词，如「成立于」" },
              "variants": { "type": "array", "items": { "type": "string" }, "description": "同义变体，如「创立于」「创建于」" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "BiTemporal": {
      "type": "object",
      "description": "双时态：valid = 事实在现实中成立的时间；recorded_at = 系统记录时间。★ recorded_at 固定为 2000-01-01T00:00:00Z（FIXED_TX），否则每次 run 都不同会让 add_edge 误判为新版本而无限追加",
      "properties": {
        "valid": { "type": "object", "properties": { "start": { "type": ["string", "null"], "format": "date-time" }, "end": { "type": ["string", "null"], "format": "date-time" } } },
        "recorded_at": { "type": ["string", "null"], "format": "date-time" },
        "invalidated_at": { "type": ["string", "null"], "format": "date-time", "description": "★ 落选边作废时间。铁律：绝不删除，只作废" }
      }
    },
    "Entity": {
      "type": "object",
      "required": ["entity_id", "canonical_name", "entity_type"],
      "properties": {
        "entity_id": { "type": "string", "description": "sha256(type, canonical_name.strip().casefold())" },
        "canonical_name": { "type": "string" },
        "entity_type": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "★ 被合并方的名字必须进 aliases，绝不丢弃（原版 entity_merger 丢别名导致用旧名字查不到）" },
        "properties": { "type": "object" },
        "mention_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number" },
        "provenance": { "type": ["object", "null"] },
        "temporal": { "$ref": "#/definitions/BiTemporal" },
        "metadata": { "type": "object" }
      }
    },
    "KGEdge": {
      "type": "object",
      "required": ["edge_id", "subject_id", "predicate"],
      "properties": {
        "edge_id": { "type": "string", "description": "sha256(subject_id, predicate, object_id|object_literal)" },
        "subject_id": { "type": "string" },
        "predicate": { "type": "string" },
        "object_id": { "type": ["string", "null"], "description": "实体边：指向另一实体" },
        "object_literal": { "type": ["string", "null"], "description": "字面量边：日期/金额等。★ 与 object_id 互斥填充" },
        "properties": { "type": "object" },
        "confidence": { "type": "number" },
        "provenance": { "type": ["object", "null"] },
        "temporal": { "$ref": "#/definitions/BiTemporal" },
        "metadata": { "type": "object" }
      }
    },
    "KnowledgeGraph": {
      "type": "object",
      "properties": {
        "entities": { "type": "object", "additionalProperties": { "$ref": "#/definitions/Entity" } },
        "edges": { "type": "object", "description": "edge_id → 该边的历史版本列表（保留作废版本）", "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/KGEdge" } } },
        "stats": { "type": "object", "properties": { "entity_count": { "type": "integer" }, "edge_count": { "type": "integer" }, "literal_edge_count": { "type": "integer" }, "mention_count": { "type": "integer" }, "orphan_entity_count": { "type": "integer" }, "by_type": { "type": "object" }, "by_predicate": { "type": "object" }, "build_ms": { "type": "integer" } } },
        "metadata": { "type": "object" }
      }
    },
    "Conflict": {
      "type": "object",
      "required": ["conflict_id", "kind", "subject_id", "predicate"],
      "properties": {
        "conflict_id": { "type": "string" },
        "kind": { "enum": ["value", "type", "temporal", "mutex", "logic"] },
        "subject_id": { "type": "string" },
        "predicate": { "type": "string" },
        "values": { "type": "array", "items": { "type": "object", "properties": { "value": {}, "confidence": { "type": "number" }, "fetched_at": { "type": ["string", "null"], "format": "date-time" }, "valid_from": { "type": ["string", "null"], "format": "date-time" }, "valid_to": { "type": ["string", "null"], "format": "date-time" } } } },
        "severity": { "type": "number" },
        "resolution": {
          "type": ["object", "null"],
          "properties": {
            "strategy": { "enum": ["most_recent", "highest_confidence", "majority_vote", "source_priority", "keep_all", "manual"], "description": "默认：有时态 → most_recent；否则 → majority_vote" },
            "chosen": {},
            "rationale": { "type": "string", "description": "★ 必须带理由" },
            "discarded": { "type": "array" },
            "needs_review": { "type": "boolean" }
          }
        }
      }
    },
    "DuplicateCluster": {
      "type": "object",
      "required": ["cluster_id", "canonical_id"],
      "properties": {
        "cluster_id": { "type": "string" },
        "entity_ids": { "type": "array", "items": { "type": "string" } },
        "canonical_id": { "type": "string", "description": "规范实体选 max(len(mention_ids), len(properties), len(aliases))" },
        "merged_properties": { "type": "object" },
        "strategy": { "enum": ["keep_most_complete", "keep_first", "keep_longest", "union_properties"] }
      }
    },
    "QualityMetrics": {
      "type": "object",
      "properties": {
        "conflict_count": { "type": "integer" },
        "unresolved_count": { "type": "integer" },
        "duplicate_cluster_count": { "type": "integer" },
        "entities_merged": { "type": "integer" },
        "edges_remapped": { "type": "integer" },
        "mean_confidence": { "type": "number" },
        "qa_ms": { "type": "integer" }
      }
    }
  }
}
