    "permissions": {
      "type": "array",
      "description": "主体-动作授权（v6 新增）：RBAC 授权边界，决策自动化治理层。permission_id 由 (actor, action, effect) 内容寻址——Python 补算。不进入实体-边图谱（build_kg 在 metadata 登记 permission_count）。",
      "items": {
        "type": "object",
        "required": [
