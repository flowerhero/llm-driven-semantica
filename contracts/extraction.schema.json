    "constraints": {
      "type": "array",
      "description": "结构约束（v6 新增）：结构合法性约束（SHACL 式），保证预测与决策不基于非法状态。constraint_id 由 (subject, type, description) 内容寻址——Python 补算。不进入实体-边图谱（build_kg 在 metadata 登记 constraint_count）。",
      "items": {
        "type": "object",
        "required": [
          "constraint_id",
          "doc_id",
          "subject",
          "type",
          "description"
        ],
        "additionalProperties": false,
